.idea/
.vscode/
*.swp
.DS_Store
.secrets/

# ---- Vendored toolchains (~2.2 GB; provisioned by docs/, not source) ----
# The wrapper SCRIPTS in tools/bin are source and are tracked; the binaries
# they exec, and the SDK trees, are downloaded artifacts. See docs/DECISIONS.md
# (ast-grep, bazelisk, Rust, Go, gazelle vendoring ADRs) for how to re-provision.
tools/bazelisk/
tools/go/
tools/rust/
tools/bin/*
!tools/bin/cargo
!tools/bin/gazelle
!tools/bin/go
!tools/bin/rustc
