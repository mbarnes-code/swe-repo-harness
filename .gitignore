.idea/
.vscode/
*.swp
.DS_Store
.secrets/

# ---- Vendored toolchains (~2.2 GB; provisioned by docs/, not source) ----
# The wrapper SCRIPTS in tools/bin are source and are tracked; the binaries
# they exec, and the SDK trees, are downloaded artifacts. See docs/DECISIONS.md
# (ast-grep, bazelisk, Rust, Go, gazelle vendoring ADRs) for how to re-provision.
tools/bazelisk/
tools/go/
tools/rust/
tools/bin/*
!tools/bin/cargo
!tools/bin/fetch-harmony-vocab
!tools/bin/gazelle
!tools/bin/go
!tools/bin/rustc
!tools/bin/security-scan

# ---- Live write paths (settings.py: cache_dir, work_dir) ----
# These are the two highest-volume targets in the system: the Bazel disk and
# repository caches, and every per-run worktree. Previously unguarded while
# `mirrors/` and `.worktrees/` -- which nothing in src/ ever writes -- were.
/cache/
/work/

# ---- Bazel droppings in THIS repo (hygiene only; NOT a fix for D26) ----
# D26 is about the generated monorepo's integration worktree under work/, in a
# different repository that this file cannot reach. Fixing D26 means changing
# the publish guard in code, not ignoring files here.
/bazel-out
/bazel-bin
/bazel-testlogs
/bazel-swe repo harness
bazel-*-events.json

# `tests/conftest._bazel_root()` writes GiB of Bazel state here when the checkout path
# contains no space. The primary checkout's path DOES contain one, so this branch is dead
# there -- but a git worktree at a space-free path revives it, and nothing else in this
# file matches. Ignored defensively so the trap cannot land untracked-but-unignored even
# if `tools/worktree/new-worktree.sh`'s space-free refusal is bypassed. See
# tools/worktree/README.md.
tools/bazel-test-root/

# ---- Third-party reference corpora (their own git repos) ----
# Cited by path in docs/DECISIONS.md; re-fetch to fact-check those citations. Each URL clones
# into the like-named directory below, and the `@ <sha>` is the whole mechanism -- an unpinned
# re-fetch of an actively-developed upstream does not reproduce the cited bytes. Nothing in CI
# resolves a citation into these corpora: see docs/DECISIONS.md ADR-0095 for what that costs.
#   https://github.com/All-The-Vibes/Agent-Harness.git              @ d1aab58
#   https://github.com/langchain-ai/deepagents.git                  @ 1c6d358
#   https://github.com/langchain-ai/open-swe.git                    @ e712a9e
#   https://github.com/visa/visa-vulnerability-agentic-harness.git  @ 3d972f6
references/*/

# ---- Claude Code per-user local overrides (machine- and session-specific) ----
.claude/settings.local.json

# ---- Harmony tokeniser vocab (openai-harmony's o200k_base.tiktoken, ~3.6 MB) ----
# NOT vendored: it is a third-party data blob with its own provenance, and `openai-harmony`
# verifies its sha256 itself. `tools/bin/fetch-harmony-vocab` fetches and hash-checks it into
# this directory; `tests/conftest.py` points TIKTOKEN_ENCODINGS_BASE here when it is present, and
# `tests/test_llm_backend_harmony_gpt_oss.py` skips (loudly, naming the script) when it is not.
tools/harmony-vocab/*.tiktoken
